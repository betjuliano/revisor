VITE_API_BASE_URL=http://localhost:4000
VITE_GEMINI_API_KEY=replace-with-gemini-api-key

# Supabase credentials used by the backend server
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# Prefer using the service role key when running the backend to allow inserts/updates.
# Keep this value private and never expose it to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Optional server configuration
PORT=4000
