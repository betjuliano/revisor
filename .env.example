VITE_API_BASE_URL=http://localhost:4000
VITE_GEMINI_API_KEY=replace-with-gemini-api-key

# Configuração do Postgres (Supabase self-hosted)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-password
POSTGRES_DB=revisor
# Defina como "true" se precisar forçar SSL
POSTGRES_SSL=false

# Opcional: string única de conexão (substitui as variáveis acima)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Configuração opcional do servidor
PORT=4000
